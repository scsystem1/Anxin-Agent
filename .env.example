# =============================================================================
# Anxin sandbox configuration
# Copy to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# DEFAULT LLM (used by every component unless overridden)
# -----------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Doubao, DeepSeek, Qwen, etc.
ANXIN_LLM_API_KEY=sk-c76a4f0127c647648e56826856308fef
ANXIN_LLM_BASE_URL=https://api.deepseek.com
ANXIN_LLM_MODEL=deepseek-v4-pro

# -----------------------------------------------------------------------------
# PER-ROLE OVERRIDES (optional)
# -----------------------------------------------------------------------------
# Use a stronger model for the judge, a cheaper one for NPCs.
# Naming convention: <ROLE>_LLM_API_KEY / _BASE_URL / _MODEL
# Roles used in code: ADVISOR, DOUBAO, WORKER, NPC, JUDGE
# (anything unset falls back to ANXIN_LLM_*)

# JUDGE_LLM_MODEL=gpt-4o
# NPC_LLM_MODEL=gpt-4o-mini

# Doubao baseline — point to the actual Doubao API for fairness
# DOUBAO_LLM_API_KEY=your-doubao-key
# DOUBAO_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_LLM_MODEL=doubao-pro-32k

# -----------------------------------------------------------------------------
# RUN CONFIGURATION
# -----------------------------------------------------------------------------
ANXIN_CASE_PATH=cases/tianjiao_mingyuan.json
ANXIN_MAX_TURNS=30
ANXIN_OUT_DIR=./out
ANXIN_VERBOSE=1
